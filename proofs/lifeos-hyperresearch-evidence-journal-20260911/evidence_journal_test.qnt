// Author: Naray Puthillathu
module evidence_journal_test {
  import evidence_journal.* from "./evidence_journal"
  run emptyBatchTest = init.then(prepare(0, false, true, false)).then(finishEmpty)
    .expect(s.outcome == "empty" and s.revision == 0)
  run exactReplayTest = init.then(prepare(2, true, true, false)).then(finishReplay)
    .expect(s.outcome == "already_present" and s.revision == 1)
  run oneItemAppendTest = init.then(prepare(1, false, true, false)).then(stage)
    .then(publish).then(confirmPublication)
    .expect(s.outcome == "appended" and s.incomingVisibleItems == 1)
  run twoItemAppendTest = init.then(prepare(2, false, true, false)).then(stage)
    .then(publish).then(confirmPublication)
    .expect(s.outcome == "appended" and s.incomingVisibleItems == 2)
  run failureBeforePublicationTest = init.then(prepare(2, false, true, false))
    .then(stage).then(failBeforePublication)
    .expect(s.outcome == "failed" and s.revision == 0 and s.incomingVisibleItems == 0)
  run ambiguousAfterPublicationTest = init.then(prepare(2, false, true, false))
    .then(stage).then(publish).then(loseConfirmation)
    .expect(s.outcome == "commit_state_unknown" and s.incomingVisibleItems == 2)
  run sameBatchWriterConvergenceTest = init.then(prepare(2, false, false, true))
    .then(observeConflict).then(reconcileOnce)
    .expect(s.outcome == "already_present" and s.reconciliationReads == 1)
  run differentBatchWriterConflictTest = init.then(prepare(2, false, false, false))
    .then(observeConflict).then(reconcileOnce)
    .expect(s.outcome == "conflict" and s.incomingVisibleItems == 0)
  run replayDoesNotReconcileTest = init.then(prepare(1, true, true, false))
    .then(finishReplay)
    .expect(s.reconciliationReads == 0 and s.initialRevision == s.revision)
  run stagedBatchNeverVisibleTest = init.then(prepare(2, false, true, false))
    .then(stage).expect(s.stagedItems == 2 and s.incomingVisibleItems == 0)
}
