// Author: Naray Puthillathu
module lifecycle_migration_test {
  import lifecycle_migration.* from "./lifecycle_migration"
  run missingLegacyTest = init.then(inspect(false, "absent"))
    .then(rejectMissingLegacy).expect(s.outcome == "not_found" and s.writes == 0)
  run identicalExistingTest = init.then(inspect(true, "identical"))
    .then(recognizeIdentical).expect(s.outcome == "already_migrated" and s.writes == 0)
  run differentExistingTest = init.then(inspect(true, "different"))
    .then(rejectDifferent).expect(s.outcome == "conflict" and s.durableKind == "different")
  run successfulMigrationTest = init.then(inspect(true, "absent")).then(stage)
    .then(publish).then(verifyExactRevision)
    .expect(s.success and s.outcome == "migrated" and s.verificationReads == 1)
  run failureBeforePublicationTest = init.then(inspect(true, "absent")).then(stage)
    .then(failBeforePublish)
    .expect(s.outcome == "failed" and s.durableKind == "absent" and s.legacyIntact)
  run ambiguousPublicationTest = init.then(inspect(true, "absent")).then(stage)
    .then(publish).then(loseConfirmation)
    .expect(s.outcome == "commit_state_unknown" and not(s.success) and s.legacyIntact)
  run competingIdenticalMigrationTest = init.then(inspect(true, "absent")).then(stage)
    .then(observeCompetingWinner(true)).then(reconcileConflict)
    .expect(s.outcome == "already_migrated" and s.writes == 0)
  run competingDifferentMigrationTest = init.then(inspect(true, "absent")).then(stage)
    .then(observeCompetingWinner(false)).then(reconcileConflict)
    .expect(s.outcome == "conflict" and s.durableKind == "different")
  run stagedSnapshotInvisibleTest = init.then(inspect(true, "absent")).then(stage)
    .expect(s.durableVisibleFields == 0 and s.legacyIntact)
  run successPreservesLegacyTest = init.then(inspect(true, "absent")).then(stage)
    .then(publish).then(verifyExactRevision)
    .expect(s.success and s.legacyIntact and s.durableVisibleFields == 6)
}
